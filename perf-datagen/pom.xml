<?xml version="1.0" encoding="UTF-8"?>
<!-- perf-datagen：独立可复用 Mock 数据生成引擎（纯 Java 库，由 perf-server 引入使用）
     设计约束：
       1. 无状态引擎，不依赖持久化——进度/语义提示经 EngineListener 回调交宿主；
       2. 依赖隔离：除 javaparser-core 外全部 provided，避免 Classpath Hell，不做 Uber-Jar；
       3. SPI 扩展点（DatabaseDialect/OrmSourceParser/BatchExecutor）本期实现 MySQL/MyBatis，
          未来新增 PostgreSQL/JPA 仅需新增实现类。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.perftestor</groupId>
        <artifactId>performance-testor</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>perf-datagen</artifactId>
    <name>perf-datagen</name>
    <description>Mock 数据生成引擎：联表外键感知（含无外键语义关联识别）/ 枚举语义化 / 魔法值感知 / MyBatis 源码解析 / Dry-Run 试运行</description>

    <dependencies>
        <!-- 模块内唯一 compile 依赖：Java 源码 AST 解析 -->
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-core</artifactId>
        </dependency>
        <!-- 日志门面：版本由宿主（Spring Boot BOM）统一提供，避免版本冲突 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- JDBC 驱动由宿主运行时提供，编译仅需 java.sql（JDK 自带），不引入驱动依赖 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- H2 内存库（MySQL 模式）：引擎编排/方言/批量执行器的无 DB 单测载体 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- PIT 突变测试：mvn -pl perf-datagen org.pitest:pitest-maven:mutationCoverage -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <targetClasses>
                        <param>com.perftestor.datagen.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.perftestor.datagen.*</param>
                    </targetTests>
                    <!-- 排除纯数据载体（getter/setter 突变无质量信号） -->
                    <excludedClasses>
                        <param>com.perftestor.datagen.model.*</param>
                    </excludedClasses>
                    <outputFormats>
                        <outputFormat>XML</outputFormat>
                        <outputFormat>HTML</outputFormat>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <jvmArgs>
                        <jvmArg>-XX:+EnableDynamicAgentLoading</jvmArg>
                    </jvmArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
