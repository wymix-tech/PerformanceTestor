{
  "name": "perf-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PerformanceTestor 前端：深色科技风监控后台（Vue3 + tdesign + ECharts）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "test:mutation:all": "stryker run stryker.config.all.json"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "echarts": "^5.5.0",
    "lucide-vue-next": "^0.441.0",
    "pinia": "^2.1.7",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.0",
    "tailwindcss": "3.4.17",
    "typescript": "~5.4.5",
    "vite": "^5.2.11",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.19"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
