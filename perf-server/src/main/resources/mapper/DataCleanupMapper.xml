<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.perfserver.mapper.DataCleanupMapper">

    <delete id="deleteTraceByApp">
        DELETE FROM trace_chain WHERE app_name = #{appName}
    </delete>

    <delete id="deleteJvmByApp">
        DELETE FROM jvm_metric WHERE app_name = #{appName}
    </delete>

    <delete id="deleteSlowSqlByApp">
        DELETE FROM slow_sql WHERE app_name = #{appName}
    </delete>

    <delete id="deleteSlowCommandByApp">
        DELETE FROM slow_command WHERE app_name = #{appName}
    </delete>

    <select id="findStressTaskIdsByApp" resultType="long">
        SELECT id FROM stress_task WHERE app_name = #{appName}
    </select>

    <delete id="deleteStressSamplesByTaskIds">
        DELETE FROM stress_sample WHERE task_id IN
        <foreach collection="taskIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteStressTasksByApp">
        DELETE FROM stress_task WHERE app_name = #{appName}
    </delete>

    <select id="findIssueIdsByApp" resultType="long">
        SELECT id FROM performance_issue WHERE app_name = #{appName}
    </select>

    <delete id="deleteFixByIssueIds">
        DELETE FROM fix_suggestion WHERE issue_id IN
        <foreach collection="issueIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteIssuesByApp">
        DELETE FROM performance_issue WHERE app_name = #{appName}
    </delete>

    <delete id="deleteAppInstancesByApp">
        DELETE FROM app_instance WHERE app_name = #{appName}
    </delete>

    <delete id="deleteDbConnsByApp">
        DELETE FROM db_conn WHERE app_name = #{appName}
    </delete>

</mapper>
