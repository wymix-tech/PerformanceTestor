<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.perfserver.mapper.SlowSqlMapper">

    <resultMap id="BaseResultMap" type="com.perfserver.entity.SlowSql">
        <id column="id" property="id"/>
        <result column="app_name" property="appName"/>
        <result column="sql_text" property="sqlText"/>
        <result column="cost_ms" property="costMs"/>
        <result column="source" property="source"/>
        <result column="db_host" property="dbHost"/>
        <result column="execute_time" property="executeTime"/>
    </resultMap>

    <insert id="batchInsert">
        INSERT INTO slow_sql (app_name, sql_text, cost_ms, source, db_host, execute_time)
        VALUES
        <foreach collection="list" item="s" separator=",">
            (#{s.appName}, #{s.sqlText}, #{s.costMs}, #{s.source}, #{s.dbHost}, #{s.executeTime})
        </foreach>
    </insert>

    <sql id="BaseColumns">
        id, app_name, sql_text, cost_ms, source, db_host, execute_time
    </sql>

    <select id="query" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM slow_sql
        WHERE execute_time &gt;= #{start} AND execute_time &lt;= #{end}
        <if test="appName != null and appName != ''">
            AND app_name = #{appName}
        </if>
        <if test="minCostMs != null">
            AND cost_ms &gt;= #{minCostMs}
        </if>
        ORDER BY cost_ms DESC
        LIMIT #{limit}
    </select>

</mapper>
