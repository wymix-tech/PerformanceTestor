<?xml version="1.0" encoding="UTF-8"?>
<!-- perf-server：后端服务平台（Spring Boot 3.x + MyBatis + MySQL），提供采集 API / 压测 / 灌数据 / 源码分析 / AI 编排 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.perftestor</groupId>
        <artifactId>performance-testor</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>perf-server</artifactId>
    <name>perf-server</name>
    <description>PerformanceTestor 后端服务：采集存储 / 压测引擎 / 数据灌入 / 容量分析 / 源码管理 / AI 智能体</description>

    <dependencies>
        <!-- 独立 Mock 数据模块：灌数引擎（联表/枚举/魔法值/Dry-Run） -->
        <dependency>
            <groupId>com.perftestor</groupId>
            <artifactId>perf-datagen</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- SSH/SFTP：AI 编排远程部署（上传编译包与 agent、远程启动） -->
        <dependency>
            <groupId>com.github.mwiede</groupId>
            <artifactId>jsch</artifactId>
        </dependency>
        <!-- JWT：轻量鉴权（api 编译期 + impl/jackson 运行期） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- PostgreSQL 驱动：灌数引擎 PostgreSQLDialect 连接 PG 目标库（与 MySQL 驱动同为运行期） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 报告导出：HTML → PDF（openhtmltopdf + PDFBox 后端） -->
        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>perf-server</finalName>
        <plugins>
            <!-- PIT 突变测试：mvn -pl perf-server org.pitest:pitest-maven:mutationCoverage -->
            <!-- 暂不设 mutationThreshold：当前 24%（source/controller/ai.tools/deploy 几乎无覆盖），
                 设阈值会常态化失败，先按报告补测试再启用门禁 -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <targetClasses>
                        <param>com.perfserver.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.perfserver.*</param>
                    </targetTests>
                    <!-- 排除无突变价值的样板：实体/配置/Mapper 接口（仅注解）/ 启动类 -->
                    <excludedClasses>
                        <param>com.perfserver.entity.*</param>
                        <param>com.perfserver.config.*</param>
                        <param>com.perfserver.mapper.*</param>
                        <param>com.perfserver.PerfServerApplication</param>
                        <!--
                          含「无上界轮询循环」的类：突变破坏退出条件（判反取反常量/删标志位赋值）
                          即成真死循环，每个都要耗满 timeout 才被强杀——128 个突变单元能拖到 30 分钟
                          以上，且 PIT 把 TIMED_OUT 计入 killed，会虚高分数。
                          这些类改用 pit-blocking profile 单独跑（长超时 + 限流）。
                          注意排除的是具体类而非整个包：stress 包内的 StepSelector /
                          ResponseVarExtractor / StressTaskRequest 是纯逻辑，突变价值高，予以保留。
                        -->
                        <param>com.perfserver.stress.HttpStressEngine</param>
                        <param>com.perfserver.stress.JmeterStressEngine</param>
                        <param>com.perfserver.service.StressGateService</param>
                        <param>com.perfserver.service.IssueVerifyService</param>
                        <param>com.perfserver.deploy.DeployService</param>
                    </excludedClasses>
                    <outputFormats>
                        <outputFormat>XML</outputFormat>
                        <outputFormat>HTML</outputFormat>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <!--
                      超时按「排除死循环类后的真实耗时」定：剩余用例均在 5s 内完成，
                      取 6s 下限。原先的 15000×1.5≈22s 是按压测引擎用例定的，
                      对常规用例纯属浪费——一次死循环就要白等 22 秒。
                    -->
                    <timeoutConstant>6000</timeoutConstant>
                    <timeoutFactor>1.25</timeoutFactor>
                    <!-- 并行跑突变：PIT 默认单线程，多核机器上这是最直接的时间收益 -->
                    <threads>4</threads>
                    <jvmArgs>
                        <jvmArg>-XX:+EnableDynamicAgentLoading</jvmArg>
                    </jvmArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
      含阻塞循环的类单独跑：
        mvn -pl perf-server -P pit-blocking org.pitest:pitest-maven:mutationCoverage

      之所以要拆出来：这些类（压测引擎 / 门禁等待 / 修复验证轮询 / SSH 部署）
      含基于标志位或 deadline 的无上界轮询循环，突变后必然死循环，只能靠超时兜底。
      混进常规执行会拖垮整体耗时，且 TIMED_OUT 计入 killed 会虚高分数；
      但直接不测又会漏掉压测引擎这类核心逻辑，故单独一个 profile、
      用更长超时串行跑，按需手动触发，不进 CI。
    -->
    <profiles>
        <profile>
            <id>pit-blocking</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses>
                                <param>com.perfserver.stress.HttpStressEngine</param>
                                <param>com.perfserver.stress.JmeterStressEngine</param>
                                <param>com.perfserver.service.StressGateService</param>
                                <param>com.perfserver.service.IssueVerifyService</param>
                                <param>com.perfserver.deploy.DeployService</param>
                            </targetClasses>
                            <targetTests>
                                <param>com.perfserver.*</param>
                            </targetTests>
                            <!-- 死循环靠超时兜底，超时设小了会把存活突变误判为超时 -->
                            <timeoutConstant>30000</timeoutConstant>
                            <timeoutFactor>1.5</timeoutFactor>
                            <!-- 串行：这类用例本身起线程池打真实 HTTP，并行会把机器打满 -->
                            <threads>1</threads>
                            <timestampedReports>false</timestampedReports>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
