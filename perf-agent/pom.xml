<?xml version="1.0" encoding="UTF-8"?>
<!-- perf-agent：监控探针（Java Agent），通过 ByteBuddy 无侵入增强被测应用，依赖尽量精简 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.perftestor</groupId>
        <artifactId>performance-testor</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>perf-agent</artifactId>
    <name>perf-agent</name>
    <description>监控探针：字节码增强方法埋点 / JDBC 拦截 / JMX 采集 / 远程批量上报</description>

    <dependencies>
        <!-- ByteBuddy：字节码增强框架 -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
        </dependency>
        <!-- byte-buddy-agent：运行时 attach 能力（预留，默认使用 premain 启动期增强） -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy-agent</artifactId>
        </dependency>
        <!-- 单元测试（版本由父 POM 的 Spring Boot BOM 管理） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>perf-agent</finalName>
        <plugins>
            <!-- PIT 突变测试：mvn -pl perf-agent org.pitest:pitest-maven:mutationCoverage -->
            <!-- 暂不设 mutationThreshold：当前 26%（reporter/jmx/hotspot 大面积无覆盖），
                 设阈值会常态化失败，先按报告补测试再启用门禁 -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <targetClasses>
                        <param>com.perfagent.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.perfagent.*</param>
                    </targetTests>
                    <!-- 排除 Agent 入口：premain 只做参数解析与 ByteBuddy 安装，需 JVM attach 环境才有意义 -->
                    <excludedClasses>
                        <param>com.perfagent.AgentPremain</param>
                    </excludedClasses>
                    <outputFormats>
                        <outputFormat>XML</outputFormat>
                        <outputFormat>HTML</outputFormat>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <jvmArgs>
                        <jvmArg>-XX:+EnableDynamicAgentLoading</jvmArg>
                    </jvmArgs>
                </configuration>
            </plugin>
            <!-- 打 fat jar 并配置 Agent Manifest（Premain-Class / Agent-Class） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- 不生成 dependency-reduced-pom.xml：它是 shade 的构建产物，
                                 曾被重新写回工作区并误提交（内含 pitest 配置噪声）。
                                 本模块的 fat jar 不作为其他模块的依赖，无需该裁剪版 pom。 -->
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Premain-Class>com.perfagent.AgentPremain</Premain-Class>
                                        <Agent-Class>com.perfagent.AgentPremain</Agent-Class>
                                        <Can-Redefine-Classes>true</Can-Redefine-Classes>
                                        <Can-Retransform-Classes>true</Can-Retransform-Classes>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/9/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
