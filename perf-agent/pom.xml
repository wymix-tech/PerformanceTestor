<?xml version="1.0" encoding="UTF-8"?>
<!-- perf-agent：监控探针（Java Agent），通过 ByteBuddy 无侵入增强被测应用，依赖尽量精简 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.perftestor</groupId>
        <artifactId>performance-testor</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>perf-agent</artifactId>
    <name>perf-agent</name>
    <description>监控探针：字节码增强方法埋点 / JDBC 拦截 / JMX 采集 / 远程批量上报</description>

    <dependencies>
        <!-- ByteBuddy：字节码增强框架 -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
        </dependency>
        <!-- byte-buddy-agent：运行时 attach 能力（预留，默认使用 premain 启动期增强） -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy-agent</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>perf-agent</finalName>
        <plugins>
            <!-- 打 fat jar 并配置 Agent Manifest（Premain-Class / Agent-Class） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Premain-Class>com.perfagent.AgentPremain</Premain-Class>
                                        <Agent-Class>com.perfagent.AgentPremain</Agent-Class>
                                        <Can-Redefine-Classes>true</Can-Redefine-Classes>
                                        <Can-Retransform-Classes>true</Can-Retransform-Classes>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/9/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
